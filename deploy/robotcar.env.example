# Example only. Create /etc/robotcar/robotcar.env as root, mode 600.
ROBOTCAR_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_VALUE
MOTOR_HOST=192.168.4.43
MOTOR_BIND=192.168.4.43
MOTOR_SWAP_SIDES=1
MOTOR_SIGNS='{"front_right":-1,"rear_right":-1}'
AUTONOMY_ENABLED=0
MOTION_CALIBRATED=0
LIDAR_BAUD=115200
LIDAR_OFFSET_DEG=-105
# Pi 4 only: set 1 to install the local USB reader and authenticated scan feed.
LIDAR_FEED_ENABLED=0
LIDAR_FEED_BIND=192.168.4.43
LIDAR_FEED_PORT=8801
# Pi 5 only: uncomment to receive scans from Pi 4 instead of opening local USB.
# LIDAR_REMOTE_URL=http://192.168.4.43:8801
HAILO_MODEL=/var/lib/robotcar/models/yolov5m_wo_spp_60p.hef
HAILO_LABELS=/var/lib/robotcar/models/coco.txt
WEB_BIND=0.0.0.0
WEB_USERNAME=pi
WEB_PASSWORD_HASH=REPLACE_WITH_SALT_AND_PBKDF2_HASH
# Pi 5: local IMX708 front + authenticated IMX219 rear from Pi 4.
CAMERA_LOCAL_ROLES=front
CAMERA_BIND=127.0.0.1
CAMERA_REAR_URL=http://192.168.4.43:8800
CAMERA_FRONT_ROTATE_180=1
CAMERA_REAR_ROTATE_180=0
# Pi 4 instead: CAMERA_LOCAL_ROLES=rear, CAMERA_BIND=192.168.4.43,
# CAMERA_FEED_ENABLED=1; omit CAMERA_REAR_URL. Do not expose 8800 to Internet.
