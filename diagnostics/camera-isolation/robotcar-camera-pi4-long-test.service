[Unit]
Description=Continuous IMX219 camera observation on robotcar Pi 4
After=local-fs.target

[Service]
Type=notify
User=pi
SupplementaryGroups=video render
WorkingDirectory=/opt/robotcar-camera-test
ExecStart=/usr/bin/python3 -u /opt/robotcar-camera-test/capture.py front
ExecStopPost=/usr/bin/python3 /opt/robotcar-camera-test/record.py front
RuntimeDirectory=robotcar-camera-test
RuntimeDirectoryPreserve=yes
StateDirectory=robotcar-camera-test
UMask=0077
NotifyAccess=main
WatchdogSec=15
WatchdogSignal=SIGKILL
TimeoutStartSec=30
TimeoutStopSec=5
KillMode=control-group
Restart=no

